[Unit]
Description=Serve Amnezia VPN dashboard
After=network-online.target amnezia-traffic-collector.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/var/lib/amnezia-traffic/web
ExecStart=/usr/bin/python3 /usr/local/bin/amnezia_dashboard_server.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
